{
  "name": "mooc-docente",
  "version": "1.0.0",
  "description": "Plataforma MOOC para preparación de concursos de méritos docentes",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --verbose",
    "seed": "node src/seed/seed.js",
    "db:preparar": "node scripts/preparar-base-local.js",
    "diagnostico:catalogo": "node scripts/diagnostico-catalogo.js",
    "carga:catalogo": "node scripts/generar-carga-catalogo.js",
    "contenido:catalogo": "node scripts/auditar-contenido-catalogo.js"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testTimeout": 30000
  },
  "keywords": [
    "mooc",
    "educación",
    "concursos",
    "docentes"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "fflate": "^0.8.3",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "saxes": "^6.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsdom": "24.1.3",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
