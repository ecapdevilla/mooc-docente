{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "indexInicial.html", "use": "@vercel/static" },
    { "src": "diagnosticoPiloto.html", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/app.js", "dest": "app.js" },
    { "src": "/index.html", "dest": "index.html" },
    { "src": "/(api-client.js|auth.js)", "dest": "public/$1" },
    { "src": "/diagnostico-piloto", "dest": "diagnosticoPiloto.html" },
    { "src": "/diagnosticoPiloto.js", "dest": "public/diagnosticoPiloto.js" },
    { "src": "/diagnosticoPiloto.css", "dest": "public/diagnosticoPiloto.css" },
    { "src": "/", "dest": "indexInicial.html" },
    { "src": "/(.*)", "dest": "indexInicial.html" }
  ],
  "headers": [
    {
      "source": "/diagnostico-piloto",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
