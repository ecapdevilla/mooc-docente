PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meritodocente
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
SALT_ROUNDS=12
# Opcional: exige dominar el cuestionario para marcar la lección como completada.
# Activar solo cuando el SPA use siempre actividades publicadas en la API.
LESSON_COMPLETION_REQUIRES_QUIZ=false

# Evaluacion final por curso (T2.4). Umbral en porcentaje (0-100); si no se
# define o no es un numero valido, el servicio usa 80.
COURSE_ASSESSMENT_PASSING_SCORE=80
# Si es "true", exige completar las lecciones del curso antes de presentar.
COURSE_ASSESSMENT_REQUIRES_LESSONS=false